{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    { "source": "/my-kpi", "destination": "/kpi/my-kpi", "permanent": false },
    { "source": "/my-kpi/:rest*", "destination": "/kpi/my-kpi/:rest*", "permanent": false },
    { "source": "/history", "destination": "/kpi/history", "permanent": false },
    { "source": "/team", "destination": "/kpi/team", "permanent": false },
    { "source": "/team/:rest*", "destination": "/kpi/team/:rest*", "permanent": false },
    { "source": "/approvals", "destination": "/kpi/approvals", "permanent": false },
    { "source": "/queries", "destination": "/kpi/queries", "permanent": false },
    { "source": "/deletions", "destination": "/kpi/deletions", "permanent": false },
    { "source": "/admin", "destination": "/kpi/admin", "permanent": false },
    { "source": "/admin/:rest*", "destination": "/kpi/admin/:rest*", "permanent": false },
    { "source": "/me", "destination": "/kpi/me", "permanent": false },
    { "source": "/help", "destination": "/kpi/help", "permanent": false },
    { "source": "/score/:rest*", "destination": "/kpi/score/:rest*", "permanent": false },
    { "source": "/submission/:rest*", "destination": "/kpi/submission/:rest*", "permanent": false },
    { "source": "/change-password", "destination": "/kpi/change-password", "permanent": false }
  ],
  "rewrites": [
    {
      "source": "/kpi/",
      "destination": "https://cyrix-kpi.vercel.app/kpi/"
    },
    {
      "source": "/spare/",
      "destination": "https://cyrix-spare-mapping.vercel.app/spare/"
    },
    {
      "source": "/bemmp/",
      "destination": "https://cyrix-bemmp-dashboard.vercel.app/bemmp/"
    },
    {
      "source": "/kpi/:path*",
      "destination": "https://cyrix-kpi.vercel.app/kpi/:path*"
    },
    {
      "source": "/spare/:path*",
      "destination": "https://cyrix-spare-mapping.vercel.app/spare/:path*"
    },
    {
      "source": "/bemmp/api/:path*",
      "destination": "https://cyrix-bemmp-dashboard.vercel.app/api/:path*"
    },
    {
      "source": "/bemmp/:path*",
      "destination": "https://cyrix-bemmp-dashboard.vercel.app/bemmp/:path*"
    },
    {
      "source": "/((?!assets/|favicon|sw\\.js).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Content-Type",
          "value": "text/javascript; charset=utf-8"
        }
      ]
    }
  ]
}
